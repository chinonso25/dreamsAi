{
  "name": "dreamsai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:mobile",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "start": "bun run dev:mobile",
    "dev:backend": "bun run dev:api",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:landing": "bun run --cwd apps/landing dev",
    "android": "bun run --cwd apps/mobile android",
    "ios": "bun run --cwd apps/mobile ios",
    "web": "bun run --cwd apps/mobile web",
    "reset-project": "bun run --cwd apps/mobile reset-project",
    "typecheck": "bun run typecheck:app && bun run typecheck:shared && bun run typecheck:backend",
    "typecheck:app": "bun run --cwd apps/mobile typecheck",
    "typecheck:shared": "bun run --cwd packages/shared typecheck",
    "typecheck:backend": "bun run --cwd apps/api typecheck",
    "test": "bun run test:app && bun run test:shared && bun run test:backend",
    "test:app": "bun run --cwd apps/mobile test",
    "test:shared": "bun run --cwd packages/shared test",
    "test:watch": "bun run --cwd apps/mobile test:watch",
    "test:backend": "bun run --cwd apps/api test",
    "lint": "bun run lint:app && bun run lint:shared",
    "lint:app": "bun run --cwd apps/mobile lint",
    "lint:shared": "eslint packages/shared",
    "build:landing": "bun run --cwd apps/landing build",
    "check:landing": "bun run build:landing && bun run --cwd apps/landing check",
    "check": "bun run typecheck && bun run lint && bun run test && bun run check:landing"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "esbuild",
    "workerd"
  ],
  "engines": {
    "node": "^24.0.0",
    "bun": ">=1.4.2"
  }
}
