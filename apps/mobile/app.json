{
  "expo": {
    "name": "Dream AI",
    "slug": "dreamAi",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon/icon.png",
    "scheme": "dreamai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.faith-tech.dreamAI",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/app-icon/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon/adaptive-icon.png",
        "backgroundColor": "#7862D9"
      },
      "package": "io.faith_tech.dreamAI",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/app-icon/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "microphonePermission": "$(PRODUCT_NAME) uses the microphone to record audio for your dream entries."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "dream-ai",
          "organization": "faith-tech"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "be57d549-d7e7-41ce-b984-9bfc8fc05ebc"
      }
    },
    "owner": "levitess-organization"
  }
}
